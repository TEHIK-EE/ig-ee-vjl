# - resource -------------------------------------------------------------------

<https://fhir.ee/vjl/Patient/patient> a fhir:Patient ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "patient"] ; # 
  fhir:meta [
     fhir:profile ( [
       fhir:v "https://fhir.ee/vjl/StructureDefinition/ee-vjl-patient"^^xsd:anyURI ;
       fhir:link <https://fhir.ee/vjl/StructureDefinition/ee-vjl-patient>
     ] )
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div [ fhir:v "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Patient patient</b></p><a name=\"patient\"> </a><a name=\"hcpatient\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profile: <a href=\"StructureDefinition-ee-vjl-patient.html\">EE VJL Patient</a></p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">Chaty Ööviiul (official) Female, DoB: 1986-01-08 ( https://fhir.ee/sid/pid/est#48601085214)</p><hr/><table class=\"grid\"><tr><td style=\"background-color: #f3f5da\" title=\"Known status of Patient\">Deceased:</td><td colspan=\"3\">false</td></tr></table></div>"^^rdf:XMLLiteral ]
  ] ; # 
  fhir:identifier ( [
     fhir:system [ fhir:v "https://fhir.ee/sid/pid/est"^^xsd:anyURI ] ;
     fhir:value [ fhir:v "48601085214" ]
  ] ) ; # 
  fhir:name ( [
     fhir:use [ fhir:v "official" ] ;
     fhir:family [ fhir:v "Ööviiul" ] ;
     fhir:given ( [ fhir:v "Chaty" ] )
  ] ) ; # 
  fhir:gender [ fhir:v "female"] ; # 
  fhir:birthDate [ fhir:v "1986-01-08"^^xsd:date] ; # 
  fhir:deceased [
     a fhir:boolean ;
     fhir:v false
  ] . # 

